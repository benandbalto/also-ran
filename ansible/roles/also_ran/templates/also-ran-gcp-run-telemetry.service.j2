[Unit]
Description=also-ran GCP per-run telemetry collector
After=network-online.target also-ran-gcp-market-observer.service
Wants=network-online.target
OnFailure=also-ran-failure@%n.service

[Service]
Environment=ALSO_RAN_GITHUB_BUDGET=/var/lib/also-ran/github-budget.json
Type=oneshot
User=also-ran
Group=also-ran
ExecStart=/usr/bin/python3 /opt/also-ran/gcp_run_telemetry.py --policy /etc/also-ran/gcp-policy.json --market-state /var/lib/also-ran/gcp-market-state.json --state /var/lib/also-ran/gcp-run-telemetry-state.json --lock /run/also-ran/gcp-run-telemetry-lock --github-token-file %d/github-token
LoadCredential=github-token:{{ also_ran_github_token_path }}
{% include 'gcp-auth.inc.j2' %}
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
RuntimeDirectory=also-ran
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/also-ran
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
